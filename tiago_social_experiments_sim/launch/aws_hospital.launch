<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- === ARGUMENTS ========================================================================== -->
    <!-- (normal|wall_avoidance|crowd_avoidance|survey_individual|survey_group|crowded) -->
    <arg name="scenario" default="normal"/>

    <arg name="people_sim" default="true"/>
    <arg name="people_lite" default="false"/>
    <arg name="people_sim_viz" default="false"/>

    <!-- (titanium|steel|iron) -->
    <arg name="robot_type" default="iron"/>

    <arg name="perception_launch" default="spencer"/>

    <arg name="navigation_launch" default="true"/>
    <arg name="navigation_benchmark" default="true"/>
    <arg name="navigation_benchmark_logs_dir" default="$(env HOME)"/>

    <arg name="global_planner" default="navfn"/>
    <arg name="local_planner" default="humap"/>
    <arg name="costmap_contexts" default="social"/>
    <arg name="nav_state" default="localization"/>

    <!-- Run debugging tools -->
    <arg name="run_sim_gui" default="true"/>
    <arg name="run_perception_viz" default="false"/>
    <arg name="run_nav_viz" default="true"/>
    <arg name="run_reconfigure" default="false"/>
    <arg name="run_plot" default="true"/>

    <!-- Simulator-specific parameters -->
    <arg name="gazebo_extra_args" default=""/>
    <arg name="gazebo_recording" default="false"/>
    <arg name="gazebo_start_paused" default="false"/>

    <!-- Automatic publishing of navigation goal -->
    <arg name="publish_goal" default="true"/>
    <arg name="publish_goal_delay" default="$(eval {'titanium': '60', 'steel': '60', 'iron': '25'}.get(arg('robot_type'), '25'))"/>

    <arg name="shared_map" default="true"/>
    <arg name="tf_world_map" value="-3.169 +2.337 +0.000 +3.1415 +0.000 +0.000"/>

    <arg name="map_file" value="$(find aws_robomaker_hospital_world)/maps/aws_hospital_slam.yaml"/>
    <arg name="allow_clearing_map_obstacles" default="false"/>
    <arg name="map_frame" default="map"/>
    <arg name="map_bounds" value="[-13.82, +7.65, -13.08, +36.31]"/>

    <!-- resources for the hospital world -->
    <env name="GAZEBO_MODEL_PATH" value="$(find aws_robomaker_hospital_world)/models:$(find aws_robomaker_hospital_world)/fuel_models:$(optenv GAZEBO_MODEL_PATH)"/>

    <!-- === NODES ============================================================================== -->
    <include file="$(find tiago_social_experiments_sim)/launch/scenario_base.launch">
        <arg name="people_sim" value="$(arg people_sim)"/>
        <arg name="people_sim_viz" value="$(arg people_sim_viz)"/>

        <arg name="robot_type" value="$(arg robot_type)"/>

        <arg name="perception_launch" value="$(arg perception_launch)"/>
        <arg name="perception_config" if="$(eval scenario == 'normal')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/normal/people_perception_ground_truth.yaml"/>
        <arg name="perception_config" if="$(eval scenario == 'wall_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/people_perception_ground_truth_common.yaml"/>
        <arg name="perception_config" if="$(eval scenario == 'crowd_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/people_perception_ground_truth_common.yaml"/>
        <arg name="perception_config" if="$(eval scenario == 'survey_individual')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_individual/people_perception_ground_truth.yaml"/>
        <arg name="perception_config" if="$(eval scenario == 'survey_group')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_group/people_perception_ground_truth.yaml"/>
        <arg name="perception_config" if="$(eval scenario == 'crowded')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/crowded/people_perception_ground_truth.yaml"/>
        <arg name="navigation_launch" value="$(arg navigation_launch)"/>
        <arg name="navigation_benchmark" value="$(arg navigation_benchmark)"/>
        <arg name="navigation_benchmark_logs_dir" value="$(arg navigation_benchmark_logs_dir)"/>
        <arg name="global_planner" value="$(arg global_planner)"/>
        <arg name="local_planner" value="$(arg local_planner)"/>
        <arg name="costmap_contexts" value="$(arg costmap_contexts)"/>
        <arg name="nav_state" value="$(arg nav_state)"/>
        <arg name="run_sim_gui" value="$(arg run_sim_gui)"/>
        <arg name="run_perception_viz" value="$(arg run_perception_viz)"/>
        <arg name="run_nav_viz" value="$(arg run_nav_viz)"/>
        <arg name="run_reconfigure" value="$(arg run_reconfigure)"/>
        <arg name="run_plot" value="$(arg run_plot)"/>
        <arg name="gazebo_extra_args" value="$(arg gazebo_extra_args)"/>
        <arg name="gazebo_recording" value="$(arg gazebo_recording)"/>
        <arg name="gazebo_start_paused" value="$(arg gazebo_start_paused)"/>
        <!-- In the 'survey_individual' scenario, robot goal is published with an external script -->
        <arg name="publish_goal" if="$(eval scenario == 'survey_individual')" value="false"/>
        <arg name="publish_goal" unless="$(eval scenario == 'survey_individual')" value="$(arg publish_goal)"/>
        <arg name="publish_goal_delay" value="$(arg publish_goal_delay)"/>

        <!-- Selecting the Gazebo world file to use -->
        <arg name="world_file_wo_people" value="$(find aws_robomaker_hospital_world)/worlds/hospital.world"/>
        <!-- Scenario-specific -->
        <arg name="world_file_people" if="$(eval scenario == 'normal' and people_lite == true)" default="$(find aws_robomaker_hospital_world)/worlds/hospital.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'normal' and people_lite != true)" default="$(find aws_robomaker_hospital_world)/worlds/hospital_crowded.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'wall_avoidance')" default="$(find aws_robomaker_hospital_world)/worlds/hospital.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'crowd_avoidance')" default="$(find aws_robomaker_hospital_world)/worlds/hospital_reception_crowd.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'survey_individual')" default="$(find aws_robomaker_hospital_world)/worlds/hospital_survey_individual.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'survey_group')" default="$(find aws_robomaker_hospital_world)/worlds/hospital_survey_group.world"/>
        <arg name="world_file_people" if="$(eval scenario == 'crowded')" default="$(find aws_robomaker_hospital_world)/worlds/hospital_crowded_scenario.world"/>

        <arg name="pose_sim" if="$(eval scenario == 'normal')" value="-x -3.2 -y 2.3 -z -0.003 -R 0.0 -P 0.0 -Y -3.1415"/>
        <arg name="pose_sim" if="$(eval scenario == 'wall_avoidance')" value="-x -5.9 -y -6.55 -z -0.003 -R 0.0 -P 0.0 -Y -1.57"/>
        <arg name="pose_sim" if="$(eval scenario == 'crowd_avoidance')" value="-x -3.6 -y 4.3 -z -0.003 -R 0.0 -P 0.0 -Y 1.54"/>
        <arg name="pose_sim" if="$(eval scenario == 'survey_individual')" value="-x -5.6 -y +4.2 -z -0.003 -R 0.0 -P 0.0 -Y -1.5"/>
        <arg name="pose_sim" if="$(eval scenario == 'survey_group')" value="-x -3.6 -y 4.3 -z -0.003 -R 0.0 -P 0.0 -Y 1.54"/>
        <arg name="pose_sim" if="$(eval scenario == 'crowded')" value="-x -3.6 -y 4.3 -z -0.003 -R 0.0 -P 0.0 -Y 1.54"/>

        <arg name="localization_pose_estimate" if="$(eval scenario == 'normal')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/normal/start_amcl.yaml"/>
        <arg name="localization_pose_estimate" if="$(eval scenario == 'wall_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/wall_avoidance/start_amcl.yaml"/>
        <arg name="localization_pose_estimate" if="$(eval scenario == 'crowd_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/crowd_avoidance/start_amcl.yaml"/>
        <arg name="localization_pose_estimate" if="$(eval scenario == 'survey_individual')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_individual/start_amcl.yaml"/>
        <arg name="localization_pose_estimate" if="$(eval scenario == 'survey_group')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_group/start_amcl.yaml"/>
        <arg name="localization_pose_estimate" if="$(eval scenario == 'crowded')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/crowded/start_amcl.yaml"/>

        <arg name="shared_map" value="$(arg shared_map)"/>
        <arg name="tf_world_map" value="$(arg tf_world_map)"/>

        <arg name="map_file" value="$(arg map_file)"/>
        <arg name="allow_clearing_map_obstacles" value="$(arg allow_clearing_map_obstacles)"/>
        <arg name="map_frame" value="$(arg map_frame)"/>
        <!-- Set `external_map` to false for scenarios in which HuBeRo actors are not spawned -->

        <arg name="goal_file" if="$(eval scenario == 'normal')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/normal/finish_pose.yaml"/>
        <arg name="goal_file" if="$(eval scenario == 'wall_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/wall_avoidance/finish_pose.yaml"/>
        <arg name="goal_file" if="$(eval scenario == 'crowd_avoidance')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/crowd_avoidance/finish_pose.yaml"/>
        <!-- in the 'survey_individual' scenario, the goal is published differently (see below) -->
        <arg name="goal_file" if="$(eval scenario == 'survey_group')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_group/finish_pose.yaml"/>
        <arg name="goal_file" if="$(eval scenario == 'crowded')" value="$(find tiago_social_experiments_sim)/config/aws_hospital/crowded/finish_pose.yaml"/>
    </include>

    <!--
        Launch HuBeRo actors ROS interfaces only in 'full' version of simulation is selected.
        Note that it will significantly affect simulation performance. Instead, `lite` mode is targeted
        for faster prototyping
    -->
    <group if="$(eval scenario == 'normal' and people_sim == true and people_lite == false)">
        <include file="$(find hubero_bringup_gazebo_ros)/launch/spawn_actor.launch">
            <arg name="actor_name" value="actor1"/>
            <arg name="pose_x" value="-7.6"/>
            <arg name="pose_y" value="-7.95"/>
            <arg name="pose_yaw" value="0.82"/>
            <arg name="map_file" value="$(arg map_file)"/>
            <arg name="shared_map" value="$(arg shared_map)"/>
            <arg name="map_frame" value="$(arg map_frame)"/>
            <arg name="tf_world_map" value="$(arg tf_world_map)"/>
            <arg name="map_bounds" value="$(arg map_bounds)"/>
        </include>
        <include file="$(find hubero_bringup_gazebo_ros)/launch/spawn_actor.launch">
            <arg name="actor_name" value="actor2"/>
            <arg name="pose_x" value="-7.50"/>
            <arg name="pose_y" value="-22.95"/>
            <arg name="pose_yaw" value="1.78"/>
            <arg name="map_file" value="$(arg map_file)"/>
            <arg name="shared_map" value="$(arg shared_map)"/>
            <arg name="map_frame" value="$(arg map_frame)"/>
            <arg name="tf_world_map" value="$(arg tf_world_map)"/>
            <arg name="map_bounds" value="$(arg map_bounds)"/>
        </include>
        <!-- scenario node - orchestrates actors movements -->
        <node pkg="tiago_social_scenarios_sim" type="aws_hospital_normal_hubero" name="aws_hospital_normal_hubero" output="screen" args="1"/>
    </group>

    <group if="$(eval scenario == 'survey_individual' and people_sim == true and people_lite == false)">
        <!--
            NOTE: in this scenario, a scripted trajectory of an actor is applied since available trajectory planning
            strategies acted somehow unnaturally once the robot crossed the path of a moving human
        -->
        <arg name="actor_name" value="actor1"/>
        <!-- Spawn actor in the simulation and let them execute a predefined trajectory (no online motion planning) -->
        <node type="trajectory_spawner.sh" pkg="hubero_bringup_gazebo_ros" name="$(arg actor_name)_traj_spawner" ns="$(arg actor_name)" output="screen"
            args="$(arg actor_name) $(find tiago_social_experiments_sim)/config/aws_hospital/survey_individual/$(arg actor_name).urdf"
        />
        <!-- Publish navigation goal for the robot using an external script -->
        <node type="publish_goal_at_distance.py" pkg="tiago_social_experiments_sim" name="distance_based_robot_goal_publisher" output="screen"
            args="$(find tiago_social_experiments_sim)/config/aws_hospital/survey_individual/finish_pose.yaml"
            if="$(arg publish_goal)">
            <!-- node parameters -->
            <param name="target_human_name" value="0"/>
            <param name="distance_threshold" value="10.57"/>
            <!-- exposing topic remappings here -->
            <remap from="/odom" to="/move_base_controller/odom"/>
            <remap from="/people" to="/people"/>
            <remap from="/move_base_simple/goal" to="/move_base_simple/goal"/>
        </node>
    </group>

    <group if="$(eval scenario == 'crowded' and people_sim == true and people_lite == false)">
        <!-- NOTE: in this scenario, a scripted trajectory of an actor is applied -->
        <arg name="actor1_name" value="actor1"/>
        <arg name="actor2_name" value="actor2"/>
        <!-- Spawn actor in the simulation and let them execute a predefined trajectory (no online motion planning) -->
        <node type="trajectory_spawner.sh" pkg="hubero_bringup_gazebo_ros" name="$(arg actor1_name)_traj_spawner" ns="$(arg actor1_name)" output="screen"
            args="$(arg actor1_name) $(find tiago_social_experiments_sim)/config/aws_hospital/crowded/$(arg actor1_name).urdf"
        />
        <node type="trajectory_spawner.sh" pkg="hubero_bringup_gazebo_ros" name="$(arg actor2_name)_traj_spawner" ns="$(arg actor2_name)" output="screen"
            args="$(arg actor2_name) $(find tiago_social_experiments_sim)/config/aws_hospital/crowded/$(arg actor2_name).urdf"
        />
        <!-- Publish navigation goal for the robot using an external script -->
        <node type="publish_goal_at_distance.py" pkg="tiago_social_experiments_sim" name="distance_based_robot_goal_publisher" output="screen"
            args="$(find tiago_social_experiments_sim)/config/aws_hospital/crowded/finish_pose.yaml"
            if="$(arg publish_goal)">
            <!-- node parameters -->
            <param name="target_human_name" value="0"/>
            <param name="distance_threshold" value="10.0"/>
            <!-- exposing topic remappings here -->
            <remap from="/odom" to="/move_base_controller/odom"/>
            <remap from="/people" to="/people"/>
            <remap from="/move_base_simple/goal" to="/move_base_simple/goal"/>
        </node>

        <!-- Customize HUMAP local planner parameters for this scenario -->
        <node if="$(eval local_planner == 'humap')" name="$(anon dynparam)" pkg="dynamic_reconfigure" type="dynparam"
            args="set_from_parameters /move_base/HumapPlannerROS" output="screen" respawn="false"
        >
            <!--
                NOTE: sim_time and sim_granularity affect how the goal pose is reached
                (these params impact the final part of the path)
            -->
            <param name="sim_time" value="+3.5"/>
            <param name="sim_granularity" value="+0.5"/>
            <param name="path_distance_scale" value="+11.0"/>
            <!-- Keepout zone -->
            <param name="personal_space_scale" value="+70.0"/>
            <!-- Ground truth perception - if actor2 crosses, let him go -->
            <param name="path_crossing_confidence_threshold" value="0.45"/>
            <!-- To reduce computational burden (multiple humans in the scenario) -->
            <param name="sfm_cn_amplifier_min" value="+2.5"/>
            <param name="sfm_cn_amplifier_max" value="+2.5"/>
            <param name="sfm_cn_amplifier_granularity" value="1.0"/>
            <param name="sfm_bw_amplifier_min" value="+4.5"/>
            <param name="sfm_bw_amplifier_max" value="+4.5"/>
            <param name="sfm_bw_amplifier_granularity" value="+1.0"/>
            <!-- Increase vel. smoothness -->
            <param name="equisampled_vx" value="6"/>
            <param name="people_closest_num" value="7"/>
        </node>
    </group>
</launch>
